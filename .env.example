# URL pública de esta app (Vercel o local)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# URL de servicios_admin para volver al dashboard principal
NEXT_PUBLIC_SERVICIOS_ADMIN_URL=https://servicios-admin.vercel.app

# —— InsForge: Winston Servicios (alumno, precios, becas y pago_prorroga) ——
# Desde el ciclo 23 se unificó pago_prorroga en Winston Servicios (misma BD del portal).
INSFORGE_SERVICIOS_URL=https://YOUR-SERVICIOS-PROJECT.insforge.app
INSFORGE_SERVICIOS_API_KEY=your-admin-api-key

# Compatibilidad (opcional): si existen, se ignoran; pago_prorroga ya no usa proyecto aparte.
# INSFORGE_PRORROGAS_URL=
# INSFORGE_PRORROGAS_API_KEY=
